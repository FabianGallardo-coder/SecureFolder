<Window x:Class="SecureFolder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SecureFolder.App.ViewModels"
        Title="SecureFolder"
        Height="600" Width="480"
        MinHeight="400" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        Foreground="White">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Global Styles -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#e94560"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#e94560"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#533483"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="TextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#533483"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="OverlayBorder" TargetType="Border">
            <Setter Property="Background" Value="#80000000"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="SecureFolder"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#e94560"
                       Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1"
                       Text="Mis carpetas seguras"
                       FontSize="14" Foreground="#888"
                       Margin="0,0,0,16"/>

            <!-- Aviso de ejecución elevada -->
            <Border Grid.Row="2"
                    Background="#3a1f1f" BorderBrush="#e94560" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibleConverter}}">
                <TextBlock Text="{Binding ElevationWarning}"
                           FontSize="11" Foreground="#e94560"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Vault List -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Vaults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    MouseLeftButtonDown="VaultCard_Click"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding IconEmoji}"
                                               FontSize="32"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"/>

                                    <!-- Vault Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="12" Foreground="#888"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding VaultFilePath}"
                                                   FontSize="10" Foreground="#555"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Padding="12,6"
                                                FontSize="12"
                                                Click="VaultActionButton_Click"
                                                Tag="{Binding}">
                                            <Button.Content>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Desbloquear"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                                    <Setter Property="Text" Value="Bloquear"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button.Content>
                                        </Button>

                                        <Button Style="{StaticResource SecondaryButton}"
                                                Padding="8,6"
                                                FontSize="12"
                                                Content="⚙"
                                                ToolTip="Opciones"
                                                Click="VaultOptionsButton_Click"
                                                Tag="{Binding}"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Bar -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ShowCreateDialogCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+ " FontWeight="Bold"/>
                        <TextBlock Text="Crear carpeta segura"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding LockAllVaultsCommand}"
                        Visibility="{Binding Vaults.Count, Converter={StaticResource CountToVisibleConverter}}"
                        Margin="8,0,0,0">
                    Bloquear todas
                </Button>
            </Grid>

            <!-- Status Bar -->
            <TextBlock Grid.Row="5"
                       Text="{Binding StatusMessage}"
                       FontSize="11" Foreground="#e94560"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>
        </Grid>

        <!-- Create Vault Dialog Overlay -->
        <Border Style="{StaticResource OverlayBorder}"
                Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVisibleConverter}}"
                MouseLeftButtonDown="Overlay_Click">
            <Border Background="#1a1a2e" CornerRadius="12"
                    Width="380" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Crear carpeta segura"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#e94560" Margin="0,0,0,16"/>

                    <TextBlock Text="Nombre" Foreground="#888" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CreateVaultName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox}"/>

                    <TextBlock Text="Ubicación" Foreground="#888" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding CreateVaultPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox}"/>

                    <TextBlock Text="Contraseña" Foreground="#888" Margin="0,12,0,4"/>
                    <PasswordBox x:Name="CreatePasswordBox"
                                 Style="{StaticResource PasswordBox}"
                                 PasswordChanged="CreatePassword_Changed"/>

                    <TextBlock Text="Confirmar contraseña" Foreground="#888" Margin="0,12,0,4"/>
                    <PasswordBox x:Name="CreatePasswordConfirmBox"
                                 Style="{StaticResource PasswordBox}"
                                 PasswordChanged="CreatePasswordConfirm_Changed"/>

                    <TextBlock Text="⚠ Si olvidás la contraseña, los datos cifrados pueden ser irrecuperables."
                               FontSize="11" Foreground="#e94560"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateVaultCommand}"
                                Content="Crear"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCreateCommand}"
                                Content="Cancelar" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Unlock Dialog Overlay -->
        <Border Style="{StaticResource OverlayBorder}"
                Visibility="{Binding IsUnlockDialogOpen, Converter={StaticResource BoolToVisibleConverter}}"
                MouseLeftButtonDown="Overlay_Click">
            <Border Background="#1a1a2e" CornerRadius="12"
                    Width="380" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Desbloquear carpeta"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#e94560" Margin="0,0,0,16"/>

                    <TextBlock Text="Contraseña" Foreground="#888" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="UnlockPasswordBox"
                                 Style="{StaticResource PasswordBox}"
                                 PasswordChanged="UnlockPassword_Changed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding UnlockVaultCommand}"
                                Content="Desbloquear"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelUnlockCommand}"
                                Content="Cancelar" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Rename Dialog Overlay -->
        <Border Style="{StaticResource OverlayBorder}"
                Visibility="{Binding IsRenameDialogOpen, Converter={StaticResource BoolToVisibleConverter}}"
                MouseLeftButtonDown="Overlay_Click">
            <Border Background="#1a1a2e" CornerRadius="12"
                    Width="380" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Renombrar carpeta segura"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#e94560" Margin="0,0,0,16"/>

                    <TextBlock Text="Nuevo nombre" Foreground="#888" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RenameVaultName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBox}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding RenameVaultCommand}"
                                Content="Renombrar"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelRenameCommand}"
                                Content="Cancelar" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Delete Confirmation Dialog Overlay -->
        <Border Style="{StaticResource OverlayBorder}"
                Visibility="{Binding IsDeleteConfirmationDialogOpen, Converter={StaticResource BoolToVisibleConverter}}"
                MouseLeftButtonDown="Overlay_Click">
            <Border Background="#1a1a2e" CornerRadius="12"
                    Width="380" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Eliminar carpeta segura"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#e94560" Margin="0,0,0,16"/>

                    <TextBlock Text="¿Estás seguro de que deseas eliminar esta carpeta?"
                               Foreground="White" Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <CheckBox Content="Eliminar archivo físico del disco"
                              IsChecked="{Binding DeletePhysicalFile}"
                              Foreground="White" Margin="0,0,0,20"/>

                    <TextBlock Text="⚠ Esta acción no se puede deshacer."
                               FontSize="11" Foreground="#e94560"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding RemoveVaultCommand}"
                                Content="Eliminar"
                                Background="#8b0000"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelDeleteCommand}"
                                Content="Cancelar" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
